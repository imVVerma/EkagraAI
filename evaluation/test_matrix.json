{
  "_comment": [
    "The evaluation test matrix for the two-LLM experiment against the v3 bank.",
    "",
    "This file is the index and the grid; the supporting definitions live in sibling",
    "files and are referenced by `sources` below, so there is exactly one definition",
    "of each thing and the matrix cannot drift from the profiles it claims to test.",
    "",
    "A cell is one scripted teach -> checkpoint -> respond -> score -> recover cycle,",
    "driven by a simulated learner profile. The harness plays LLM2 from the profile,",
    "lets LLM1 (the tutor, once wired) produce the turn, then asserts the expected",
    "outcome. Until the tutor is wired, cells can be run against the deterministic",
    "reference in backend/scoring_service.py as a baseline; cells that diverge there",
    "are recorded, not counted as tutor failures.",
    "",
    "Nothing here is wired into backend/server.py. The deterministic runtime keeps",
    "loading the v1 bank; these artifacts target the v3 bank by explicit path.",
    "",
    "Run order is deliberate: level progression first (does the tutor teach at all),",
    "then global rules (does it handle the edge turns), then pedagogy coverage (can",
    "each approach carry a pass), then retry and exhaustion (does it fail forward)."
  ],

  "schema_version": "ekagra-test-matrix-v1",
  "name": "EkagraAI tutor evaluation matrix (v3 bank)",
  "knowledge_bank": {
    "path": "Resources/arthashastra-solo-knowledge-bank-v3.json",
    "source_markdown": "Resources/arthashastra-solo-knowledge-bank-v3.md",
    "version": "3",
    "counts": {
      "anchors": 6,
      "recall_items": 31,
      "transitions": 4,
      "cases": 12,
      "checkpoints": 10,
      "branching_rules": 14,
      "assessment_sets": 36,
      "global_rules": 5
    }
  },

  "sources": {
    "learner_profiles": "evaluation/learner_profiles.json",
    "transition_coverage": "evaluation/transition_coverage.json",
    "pedagogy_failure_cases": "evaluation/pedagogy_failure_cases.json",
    "retry_checks": "evaluation/retry_checks.json",
    "progression_rules": "evaluation/progression_rules.json",
    "coverage_report_schema": "evaluation/coverage_report.schema.json"
  },

  "llm_foundation": {
    "_comment": "Roles and version stamps the harness must attach to every run record.",
    "roles": {
      "tutor": {"env": "EKAGRA_TUTOR_MODEL", "agent": "tutor", "description": "LLM1, the tutor"},
      "evaluator": {"env": "EKAGRA_EVALUATOR_MODEL", "agent": "evaluator", "description": "LLM2, the simulated learner / judge"}
    },
    "prompt_version_default": "ekagra-llm-foundation-v1",
    "knowledge_bank_version_fn": "backend.llm.config.knowledge_bank_version",
    "usage_log": "logs/api_usage.jsonl",
    "cost_summary": "logs/cost_summary.json",
    "budget_env": {
      "request": "EKAGRA_MAX_REQUEST_COST_USD",
      "session": "EKAGRA_MAX_SESSION_COST_USD",
      "experiment": "EKAGRA_MAX_EXPERIMENT_COST_USD"
    }
  },

  "dimensions": {
    "transitions": ["C1", "C2", "C3", "C4"],
    "pedagogies": ["Worked Example", "Guided Questioning", "Contrasting Cases"],
    "cases_by_transition": {
      "C1": ["1A", "1B", "1C"],
      "C2": ["2A", "2B", "2C"],
      "C3": ["3A", "3B", "3C"],
      "C4": ["4A", "4B", "4C"]
    },
    "profiles_source": "evaluation/learner_profiles.json#profiles[].id",
    "global_rules": [
      "refusal_or_meta_answer",
      "copy_paste_case",
      "overlong_non_answer",
      "correct_vocabulary_wrong_application",
      "moral_objection"
    ]
  },

  "cell_schema": {
    "id": "string, unique within the matrix",
    "group": "one of level_progression | global_rules | pedagogy_coverage | retry_pass | exhaustion | scenario_retry",
    "transition_id": "C1..C4",
    "case_id": "case id, or null when the cell starts at the transition's first case",
    "pedagogy": "a pedagogy name, or 'any' when order is random",
    "profile_id": "a profile id from learner_profiles.json",
    "runner": "deterministic | llm",
    "expected": {
      "target_signature_met": "boolean, or null when only the recovery outcome is asserted",
      "assigned_solo_level": "expected level, or null when not asserted",
      "status": "pass | fail | intervention | manual_review | session_complete",
      "recovery": "null | intervention | manual_review",
      "same_case_on_retry": "boolean or null",
      "pedagogies_distinct": "boolean or null",
      "next_transition": "transition id or null"
    },
    "expected_invariants": "list of progression rule ids that must hold for this cell",
    "checks": "list of assertion strings the harness records per cell"
  },

  "cells": [
    {"id": "A-C1-pass", "group": "level_progression", "transition_id": "C1", "case_id": "1A", "pedagogy": "any", "profile_id": "unistructural_single_tool", "runner": "llm", "expected": {"target_signature_met": true, "assigned_solo_level": "unistructural", "status": "pass", "recovery": null, "next_transition": "C2"}, "expected_invariants": ["PROG-PASS-ADVANCE", "PROG-ATTEMPT-COUNT"]},
    {"id": "A-C1-fail", "group": "level_progression", "transition_id": "C1", "case_id": "1A", "pedagogy": "any", "profile_id": "prestructural_transduction", "runner": "llm", "expected": {"target_signature_met": false, "assigned_solo_level": "prestructural", "status": "fail", "recovery": null}, "expected_invariants": ["PROG-FAIL-RETRY", "PROG-SCENARIO-FIXED"]},
    {"id": "A-C2-pass", "group": "level_progression", "transition_id": "C2", "case_id": "2A", "pedagogy": "any", "profile_id": "multistructural_tool_list", "runner": "llm", "expected": {"target_signature_met": true, "assigned_solo_level": "multistructural", "status": "pass", "recovery": null, "next_transition": "C3"}, "expected_invariants": ["PROG-PASS-ADVANCE"]},
    {"id": "A-C2-fail", "group": "level_progression", "transition_id": "C2", "case_id": "2A", "pedagogy": "any", "profile_id": "unistructural_single_tool", "runner": "llm", "expected": {"target_signature_met": false, "assigned_solo_level": "unistructural", "status": "fail", "recovery": null}, "expected_invariants": ["PROG-FAIL-RETRY"]},

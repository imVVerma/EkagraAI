  ],

  "coverage_requirements": {
    "source": "evaluation/transition_coverage.json",
    "rule": "A run is complete only when every global and per-transition requirement in that file holds; cells_run alone is not coverage.",
    "planned_cells": 43
  },

  "runner": {
    "deterministic": {
      "description": "Baseline: feed each profile's sample_response to backend/scoring_service.score_response with the transition's target_signature and the case's level_examples.",
      "entry_point": "backend.scoring_service.score_response",
      "network": false,
      "api_key_required": false
    },
    "llm": {
      "description": "Two-agent run: LLM1 produces the teaching/checkpoint/intervention turn; LLM2 plays the profile and/or judges the turn. Requires wiring, which is out of scope for this artifact.",
      "entry_point": "backend.llm.openrouter_client.OpenRouterClient (not yet wired to the tutor loop)",
      "network": true,
      "api_key_required": true,
      "guarded_by": "backend.llm.budget.BudgetGuard",
      "stamps": ["knowledge_bank.sha256", "prompt_version", "tutor_model", "evaluator_model"]
    }
  },

  "scoring": {
    "gate": "target_signature_met from the transition, not the SOLO label",
    "per_cell_checks": [
      "expected.target_signature_met",
      "expected.assigned_solo_level when not null",
      "expected.status and expected.recovery",
      "every progression rule id in expected_invariants",
      "each assertion string in checks"
    ],
    "tutor_verdict": "Only runner='llm' cells decide the tutor. runner='deterministic' cells populate baseline_divergences_observed and never count as tutor failures.",
    "output": "evaluation/coverage_report.schema.json"
  },

  "out_of_scope": [
    "wiring the tutor or evaluator into backend/server.py",
    "changing the default knowledge bank loaded by backend/content_loader.py",
    "editing the v3 markdown or the v3 JSON by hand",
    "using openrouter/free or any model id absent from config/benchmark.json",
    "treating the deterministic scorer's divergences as tutor regressions"
  ]
}

    {"id": "A-C4-pass", "group": "level_progression", "transition_id": "C4", "case_id": "4A", "pedagogy": "any", "profile_id": "extended_abstract_with_condition", "runner": "llm", "expected": {"target_signature_met": true, "assigned_solo_level": "extended_abstract", "status": "session_complete", "recovery": null, "next_transition": null}, "expected_invariants": ["PROG-PASS-COMPLETE"]},

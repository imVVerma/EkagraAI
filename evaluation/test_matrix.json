    {"id": "A-C3-fail", "group": "level_progression", "transition_id": "C3", "case_id": "3A", "pedagogy": "any", "profile_id": "multistructural_tool_list", "runner": "llm", "expected": {"target_signature_met": false, "assigned_solo_level": "multistructural", "status": "fail", "recovery": null}, "expected_invariants": ["PROG-FAIL-RETRY"]},

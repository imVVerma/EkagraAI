# EkagraAI — LLM experiment configuration
#
# Copy to `.env` and fill in. `.env` is read by backend/llm/config.py and must
# never be committed. Real values are not in this file.
#
#   cp .env.example .env
#
# The key is read from the environment only. It is never written to a log, a
# summary, or an error message.


# ---------------------------------------------------------------------------
# Credentials
#
# Credentials are resolved PER PROVIDER and are never shared between
# providers. Set exactly the variable belonging to the provider named in
# EKAGRA_LLM_PROVIDER.
#
#   OpenRouter : EKAGRA_API_KEY, or OPENROUTER_API_KEY (legacy)
#   Groq       : EKAGRA_GROQ_API_KEY, or GROQ_API_KEY (legacy)
#
# A key set for one provider is ignored by the other. This is intentional: the
# two are billed and authenticated separately, so borrowing one for the other
# would either fail with a confusing 401 or charge the wrong account.
# ---------------------------------------------------------------------------

# --- OpenRouter -----------------------------------------------------------
# https://openrouter.ai/keys
EKAGRA_API_KEY=

# --- Groq -----------------------------------------------------------------
# https://console.groq.com/keys
EKAGRA_GROQ_API_KEY=

# ---------------------------------------------------------------------------
# Provider
#
#   openrouter  (default)  -> uses EKAGRA_API_KEY
#   groq                   -> uses EKAGRA_GROQ_API_KEY
#
# Any other value is a ConfigurationError. It is not silently defaulted,
# because defaulting would send a Groq-shaped request to OpenRouter.
# ---------------------------------------------------------------------------
EKAGRA_LLM_PROVIDER=openrouter

# Base URLs, per provider. Only set these to point at a proxy.
# EKAGRA_API_BASE_URL=https://openrouter.ai/api/v1
# EKAGRA_GROQ_API_BASE_URL=https://api.groq.com/openai/v1

# ---------------------------------------------------------------------------
# Model roles (LLM1 / LLM2)
#
# These are deliberately separate variables. LLM1 and LLM2 are independent
# choices and one is never defaulted to the other — that would quietly bias any
# comparison between them.
#
# Leave both unset while benchmarking: tools/model_benchmark.py names each
# candidate explicitly and does not read these.
#
# Do NOT use "openrouter/free". It chooses a different model at random per
# request, so a run cannot be reproduced. Pin a specific model id.
# ---------------------------------------------------------------------------

EKAGRA_TUTOR_MODEL=
EKAGRA_EVALUATOR_MODEL=

# ---------------------------------------------------------------------------
# Hard cost boundaries
#
# Enforced by backend/llm/budget.py: a request is estimated and refused BEFORE it
# is sent, and every call's real cost is recorded afterwards. When the experiment
# budget is reached, all further LLM requests are refused and the reason is
# reported.
#
# Defaults in parentheses apply when unset. Failing closed is deliberate.
# ---------------------------------------------------------------------------

# One request may not be worth more than this.   (default 0.05)
EKAGRA_MAX_REQUEST_COST_USD=0.05

# One learner session may not have spent more than this.   (default 0.50)
EKAGRA_MAX_SESSION_COST_USD=0.50

# The whole experiment may not spend more than this.   (default 1.00)
EKAGRA_MAX_EXPERIMENT_COST_USD=1.00

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------

# Where api_usage.jsonl and cost_summary.json are written.   (default ./logs)
EKAGRA_LOG_DIR=

# OpenRouter attribution headers, used to label the app on a project dashboard.
EKAGRA_APP_TITLE=EkagraAI
EKAGRA_APP_URL=

# Per-request HTTP timeout, seconds.   (default 120)
EKAGRA_REQUEST_TIMEOUT_SECONDS=120

# Default cap on completion length.   (default 1024)
EKAGRA_MAX_OUTPUT_TOKENS=1024

# Characters per token, used only to size the pre-flight estimate. The real
# figure always comes back from OpenRouter.   (default 4.0)
EKAGRA_TOKEN_ESTIMATE_DIVISOR=4.0

# Refuse a model whose price cannot be read from the catalogue, instead of
# calling it without an estimate. The experiment-wide limit is enforced either
# way.   (default false)
EKAGRA_REQUIRE_PRICING_FOR_GUARD=false

# ---------------------------------------------------------------------------
# Live-mode safety
#
# When EKAGRA_MODE=live and LLM1 fails, the failure is recorded and returned as
# a failure. It is NOT replaced with deterministic content, unless the variable
# below is explicitly set to true.   (default false)
#
# Keep this false for every controlled experiment. With it true, a failed LLM1
# call is served as deterministic tutor output, which makes a provider outage
# indistinguishable from a working tutor in the results.
# ---------------------------------------------------------------------------
EKAGRA_ALLOW_DETERMINISTIC_FALLBACK=false

# EKAGRA_MODE=deterministic   # or live, only when deliberately evaluating LLM1

# ---------------------------------------------------------------------------
# Experiment attribution
#
# Both are required for a live run; a call that cannot be attributed to an
# experiment and a run is refused before the first request.
# ---------------------------------------------------------------------------
EKAGRA_EXPERIMENT_ID=
EKAGRA_RUN_ID=

# Stamps recorded on every usage entry and decision trace.
EKAGRA_PROMPT_VERSION=
EKAGRA_CONFIGURATION_VERSION=
EKAGRA_KNOWLEDGE_BANK_RELEASE=